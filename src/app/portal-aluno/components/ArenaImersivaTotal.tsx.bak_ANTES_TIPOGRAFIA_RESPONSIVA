"use client";

import React, { useState } from "react";
import { ChevronUp, ChevronDown, CheckCircle2, XCircle, Sparkles, X, Quote, HelpCircle } from "lucide-react";
import ArenaHeaderMobile from "./ArenaHeaderMobile";
import RenderizadorMiolosArena, { TipoMioloExercico } from "./RenderizadorMiolosArena";

interface ArenaImersivaProps {
  onFechar: () => void;
  idiomaSelecionado?: string;
  statusRespostaMobile?: "IDLE" | "CORRECT" | "WRONG";
  setStatusRespostaMobile?: React.Dispatch<React.SetStateAction<"IDLE" | "CORRECT" | "WRONG">>;
  tipoExercicoAtual?: TipoMioloExercico | string;
  unidadeAtiva?: string;
  ditadoIncentivoSupabase?: string;
  explicacaoPedagogicaSupabase?: string;
}

export default function ArenaImersivaTotal({
  onFechar,
  idiomaSelecionado = "PT",
  statusRespostaMobile,
  setStatusRespostaMobile,
  tipoExercicoAtual = "MULTIPLA_ESCOLHA",
  unidadeAtiva,
  ditadoIncentivoSupabase,
  explicacaoPedagogicaSupabase
}: ArenaImersivaProps) {
  // Estados da capa e split
  const [capaAtiva, setCapaAtiva] = useState(true);
  const [animandoSplit, setAnimandoSplit] = useState(false);
  const [contador, setContador] = useState<number | string | null>(null);

  // Estados do jogo e feedback
  const [statusLocal, setStatusLocal] = useState<"IDLE" | "CORRECT" | "WRONG">("IDLE");
  const statusAtual = statusRespostaMobile !== undefined ? statusRespostaMobile : statusLocal;

  const [explicacaoSupabase, setExplicacaoSupabase] = useState<string>("");

  // Controladores de interface
  const [gavetaExpandida, setGavetaExpandida] = useState(false);
  const [balaoIaAberto, setBalaoIaAberto] = useState(false);

  const iniciarContagemOuSplit = () => {
    if (animandoSplit) return;

    if (contador !== null) {
      executarSplit();
      return;
    }

    let tempo = 3;
    setContador(tempo);
    const intervalo = setInterval(() => {
      tempo -= 1;
      if (tempo > 0) {
        setContador(tempo);
      } else {
        setContador(idiomaSelecionado === "PT" ? "¡BORA!" : idiomaSelecionado === "ES" ? "¡VAMOS!" : "GO!");
        clearInterval(intervalo);
        setTimeout(() => {
          executarSplit();
        }, 500);
      }
    }, 900);
  };

  const executarSplit = () => {
    setAnimandoSplit(true);
    setTimeout(() => {
      setCapaAtiva(false);
      setAnimandoSplit(false);
      setContador(null);
    }, 700);
  };

  const handleValidateResult = (isCorrect: boolean, feedbackTexto?: string) => {
    const novoStatus = isCorrect ? "CORRECT" : "WRONG";
    if (setStatusRespostaMobile) {
      setStatusRespostaMobile(novoStatus);
    } else {
      setStatusLocal(novoStatus);
    }
    if (feedbackTexto) setExplicacaoSupabase(feedbackTexto);
    setGavetaExpandida(false);
  };

  const resetarParaProximo = () => {
    if (setStatusRespostaMobile) {
      setStatusRespostaMobile("IDLE");
    } else {
      setStatusLocal("IDLE");
    }
    setExplicacaoSupabase("");
    setGavetaExpandida(false);
  };

  const ditadoExibido = ditadoIncentivoSupabase || (
    statusAtual === "CORRECT"
      ? "Água mole em pedra dura, tanto bate até que fura!"
      : statusAtual === "WRONG"
      ? "É errando que se aprende. A prática leva à perfeição!"
      : "Resolva o exercício acima para analisar a resposta."
  );

  return (
    <div className="fixed inset-0 z-[999999] w-screen h-screen bg-[#030712] text-white flex flex-col justify-between overflow-hidden font-sans select-none">
      
      {/* 1. CAPA OVERLAY TOTAL */}
      {capaAtiva && (
        <div 
          onClick={iniciarContagemOuSplit}
          className="fixed inset-0 z-[1000000] w-full h-full cursor-pointer flex flex-col overflow-hidden"
        >
          <div 
            className={`w-full h-1/2 bg-[#030712] border-b border-white/10 flex items-end justify-center pb-6 transition-transform duration-700 ease-in-out ${
              animandoSplit ? "-translate-y-full" : "translate-y-0"
            }`}
          >
            <h1 className="text-2xl sm:text-3xl font-mono font-black tracking-widest text-amber-400 uppercase text-center px-4">
              {idiomaSelecionado === "PT" ? "TREINO PRONTIFICADO" : idiomaSelecionado === "ES" ? "ENTRENAMIENTO LISTO" : "TRAINING READY"}
            </h1>
          </div>

          <div 
            className={`w-full h-1/2 bg-[#030712] border-t border-white/10 flex items-start justify-center pt-6 transition-transform duration-700 ease-in-out ${
              animandoSplit ? "translate-y-full" : "translate-y-0"
            }`}
          >
            {contador === null ? (
              <p className="text-xs sm:text-sm font-sans font-medium text-slate-400 tracking-wide text-center px-4 animate-pulse">
                {idiomaSelecionado === "PT" ? "Toque em qualquer lugar para iniciar" : "Tap anywhere to start"}
              </p>
            ) : (
              <div className="text-6xl sm:text-8xl font-mono font-black text-amber-500 animate-bounce">
                {contador}
              </div>
            )}
          </div>
        </div>
      )}

      {/* 2. HEADER DO TOPO */}
      <div className="w-full shrink-0 z-30">
        <ArenaHeaderMobile
          precisao={77}
          streak={1}
          unidadeAtual="1/5"
          pts={3}
          creditosIA={499461}
          onOpenLeitura={() => alert("Abrir Leitura")}
          onOpenVideo={() => alert("Abrir Vídeo")}
          onOpenChatIA={() => setBalaoIaAberto(!balaoIaAberto)}
        />
      </div>

      {/* 3. MIOLO DO JOGO - OCUPA TODO O ESPAÇO ÚTIL VERTICAL E HORIZONTAL */}
      <main className="flex-1 w-full h-full flex flex-col justify-between items-center px-4 sm:px-6 pt-3 pb-24 overflow-y-auto z-10">
        <div className="w-full max-w-2xl flex-1 flex flex-col justify-evenly gap-4 my-auto">

          {balaoIaAberto && (
            <div className="bg-amber-500/10 border border-amber-500/30 rounded-2xl p-4 text-xs text-amber-200 flex items-start gap-3 relative animate-fadeIn shadow-lg shrink-0">
              <Sparkles size={18} className="text-amber-400 shrink-0 mt-0.5" />
              <div className="flex-1 pr-4">
                <p className="font-bold mb-1 text-amber-300">Assistente IA:</p>
                <p>Análise em tempo real do exercício. Leia cada elemento com cuidado!</p>
              </div>
              <button 
                onClick={() => setBalaoIaAberto(false)}
                className="text-amber-400/60 hover:text-amber-300 absolute top-2 right-2 p-1"
              >
                <X size={14} />
              </button>
            </div>
          )}

          {/* RENDERIZADOR DOS EXERCÍCIOS DENTRO DE CONTAINER FLUIDO */}
          <div className="w-full flex-1 flex flex-col justify-center items-center">
            <RenderizadorMiolosArena
              tipo={tipoExercicoAtual}
              status={statusAtual}
              unidadeAtiva={unidadeAtiva}
              onValidateResult={handleValidateResult}
            />
          </div>

        </div>
      </main>

      {/* 4. GAVETINHA DO RODAPÉ PERMANENTE */}
      <div 
        className={`fixed bottom-0 left-0 right-0 z-50 bg-[#070c18] border-t border-white/15 rounded-t-3xl shadow-[0_-10px_40px_rgba(0,0,0,0.9)] transition-all duration-300 ease-in-out flex flex-col ${
          gavetaExpandida ? "h-[320px]" : "h-[75px]"
        }`}
      >
        <div 
          onClick={() => setGavetaExpandida(!gavetaExpandida)}
          className="w-full pt-2 pb-1 flex justify-center cursor-pointer shrink-0"
        >
          <div className="w-12 h-1.5 bg-white/20 rounded-full hover:bg-amber-500/60 transition-colors" />
        </div>

        <div 
          onClick={() => setGavetaExpandida(!gavetaExpandida)}
          className="w-full px-5 pb-3 flex items-center justify-between cursor-pointer shrink-0"
        >
          <div className="flex items-center gap-3">
            {statusAtual === "CORRECT" ? (
              <CheckCircle2 size={24} className="text-emerald-400 shrink-0" />
            ) : statusAtual === "WRONG" ? (
              <XCircle size={24} className="text-rose-400 shrink-0" />
            ) : (
              <HelpCircle size={24} className="text-amber-400 shrink-0" />
            )}
            
            <div className="flex flex-col">
              <span className={`font-black text-sm ${
                statusAtual === "CORRECT" ? "text-emerald-400" : statusAtual === "WRONG" ? "text-rose-400" : "text-amber-400"
              }`}>
                {statusAtual === "CORRECT" 
                  ? "Muito bem, você acertou!" 
                  : statusAtual === "WRONG" 
                  ? "Não foi desta vez..." 
                  : "Painel de Resposta"}
              </span>
              
              <span className="text-[11px] text-slate-400 font-medium line-clamp-1 italic">
                "{ditadoExibido}"
              </span>
            </div>
          </div>

          <div className="flex items-center gap-1 bg-white/5 border border-white/10 px-2.5 py-1.5 rounded-xl text-amber-400 hover:bg-amber-500/10 transition-colors">
            {gavetaExpandida ? <ChevronDown size={18} /> : <ChevronUp size={18} className="animate-bounce" />}
          </div>
        </div>

        <div className="px-5 pb-5 flex-1 overflow-y-auto flex flex-col justify-between bg-[#030712]/90 rounded-b-3xl">
          <div className="space-y-3 pt-2">
            <div className="bg-amber-500/10 border border-amber-500/20 rounded-xl p-3 flex items-start gap-2.5">
              <Quote size={16} className="text-amber-400 shrink-0 mt-0.5" />
              <div>
                <span className="text-[10px] font-mono font-bold text-amber-400 uppercase tracking-wider block mb-0.5">
                  DITADO POPULAR / INCENTIVO
                </span>
                <p className="text-xs text-amber-200/90 italic font-serif">
                  "{ditadoExibido}"
                </p>
              </div>
            </div>

            <div className="bg-slate-900/80 border border-white/10 rounded-xl p-3">
              <span className="text-[10px] font-mono font-bold text-cyan-400 uppercase tracking-wider block mb-1">
                EXPLICAÇÃO DA RESPOSTA
              </span>
              <p className="text-xs text-slate-300 leading-relaxed">
                {explicacaoSupabase || explicacaoPedagogicaSupabase || (
                  statusAtual === "CORRECT"
                    ? "Excelente! Sua resposta atende os critérios da questão."
                    : statusAtual === "WRONG"
                    ? "A alternativa selecionada não é a adequada para este contexto."
                    : "Interaja com o miolo do exercício acima para gerar a análise."
                )}
              </p>
            </div>
          </div>

          {statusAtual !== "IDLE" && (
            <button
              onClick={resetarParaProximo}
              className="w-full py-3 bg-gradient-to-r from-amber-500 to-orange-500 text-white font-black text-xs rounded-xl uppercase tracking-wider active:scale-95 transition-transform cursor-pointer shadow-lg shadow-orange-500/20 mt-3"
            >
              CONTINUAR ➔
            </button>
          )}
        </div>

      </div>

    </div>
  );
}
