"use client";

import React, { useState } from "react";
import { ChevronUp, ChevronDown, CheckCircle2, XCircle, Sparkles, X } from "lucide-react";
import ArenaHeaderMobile from "./ArenaHeaderMobile";

interface ArenaImersivaProps {
  onFechar: () => void;
  idiomaSelecionado?: string;
  statusRespostaMobile?: "IDLE" | "CORRECT" | "WRONG";
  setStatusRespostaMobile?: React.Dispatch<React.SetStateAction<"IDLE" | "CORRECT" | "WRONG">>;
}

export default function ArenaImersivaTotal({
  onFechar,
  idiomaSelecionado = "PT",
  statusRespostaMobile,
  setStatusRespostaMobile
}: ArenaImersivaProps) {
  const [capaAtiva, setCapaAtiva] = useState(true);
  const [contador, setContador] = useState<number | string | null>(null);

  // Fallback de estado local caso a prop externa não venha
  const [statusLocal, setStatusLocal] = useState<"IDLE" | "CORRECT" | "WRONG">("IDLE");
  const statusAtual = statusRespostaMobile !== undefined ? statusRespostaMobile : statusLocal;

  // Controladores da gaveta e do balão de IA
  const [gavetaExpandida, setGavetaExpandida] = useState(false);
  const [balaoIaAberto, setBalaoIaAberto] = useState(false);

  const iniciarContagem = () => {
    if (contador !== null) return;
    let tempo = 3;
    setContador(tempo);
    const intervalo = setInterval(() => {
      tempo -= 1;
      if (tempo > 0) {
        setContador(tempo);
      } else {
        setContador(idiomaSelecionado === "PT" ? "¡BORA!" : idiomaSelecionado === "ES" ? "¡VAMOS!" : "GO!");
        clearInterval(intervalo);
        setTimeout(() => {
          setCapaAtiva(false);
          setContador(null);
        }, 600);
      }
    }, 1000);
  };

  const selecionarResposta = (tipo: "CORRECT" | "WRONG") => {
    if (setStatusRespostaMobile) {
      setStatusRespostaMobile(tipo);
    } else {
      setStatusLocal(tipo);
    }
    setGavetaExpandida(false);
  };

  const resetarResposta = () => {
    if (setStatusRespostaMobile) {
      setStatusRespostaMobile("IDLE");
    } else {
      setStatusLocal("IDLE");
    }
    setGavetaExpandida(false);
  };

  return (
    <div className="fixed inset-0 z-[999999] w-screen h-screen bg-[#030712] text-white flex flex-col justify-between overflow-hidden font-sans select-none">
      
      {/* 1. TOPO DA ARENA */}
      <div className="w-full shrink-0 z-30">
        <ArenaHeaderMobile
          precisao={77}
          streak={1}
          unidadeAtual="1/5"
          nivelText="A1 • 77%"
          pts={3}
          creditosIA={499461}
          onOpenLeitura={() => alert("Abrir Material de Leitura")}
          onOpenVideo={() => alert("Abrir Aula em Vídeo")}
          onOpenChatIA={() => setBalaoIaAberto(!balaoIaAberto)}
        />
      </div>

      {/* 2. ÁREA CENTRAL DO JOGO */}
      <main className="flex-1 flex flex-col justify-center items-center px-4 relative z-10 overflow-y-auto pb-24">
        {capaAtiva ? (
          /* CAPA / CONTAGEM REGRESSIVA */
          <div 
            onClick={iniciarContagem}
            className="w-full h-full flex flex-col items-center justify-center text-center cursor-pointer"
          >
            {contador === null ? (
              <div className="flex flex-col items-center gap-3">
                <h1 className="text-2xl sm:text-3xl font-mono font-black tracking-widest text-white uppercase">
                  {idiomaSelecionado === "PT" ? "TREINO PRONTIFICADO" : idiomaSelecionado === "ES" ? "ENTRENAMIENTO LISTO" : "TRAINING READY"}
                </h1>
                <p className="text-sm font-sans font-medium text-slate-400">
                  {idiomaSelecionado === "PT" ? "Toque em qualquer lugar para iniciar" : "Tap anywhere to start"}
                </p>
              </div>
            ) : (
              <div className="text-7xl md:text-9xl font-mono font-black text-amber-500 animate-pulse">
                {contador}
              </div>
            )}
          </div>
        ) : (
          /* EXERCÍCIO ATIVO */
          <div className="w-full max-w-md flex flex-col gap-4">
            
            <div className="flex justify-between items-center border-b border-white/10 pb-2">
              <span className="text-xs font-mono font-bold text-cyan-400 uppercase tracking-widest">
                EXERCÍCIO PRÁTICO
              </span>
              <button 
                onClick={onFechar}
                className="bg-rose-500/20 hover:bg-rose-500/40 text-rose-300 border border-rose-500/30 rounded-lg px-2.5 py-1 text-[10px] font-bold cursor-pointer transition-all"
              >
                ✕ SAIR
              </button>
            </div>

            {/* BALÃO DA IA NO TOPO */}
            {balaoIaAberto && (
              <div className="bg-amber-500/10 border border-amber-500/30 rounded-2xl p-4 text-xs text-amber-200 flex items-start gap-3 relative animate-fadeIn shadow-lg">
                <Sparkles size={18} className="text-amber-400 shrink-0 mt-0.5" />
                <div className="flex-1 pr-4">
                  <p className="font-bold mb-1 text-amber-300">Assistente IA:</p>
                  <p>Preste atenção no tempo verbal da oração antes de marcar a sua opção!</p>
                </div>
                <button 
                  onClick={() => setBalaoIaAberto(false)}
                  className="text-amber-400/60 hover:text-amber-300 absolute top-2 right-2 p-1"
                >
                  <X size={14} />
                </button>
              </div>
            )}

            {/* CARD COM AS RESPOSTAS A, B */}
            <div className="bg-slate-900/90 border border-white/10 rounded-2xl p-5 text-center shadow-2xl">
              <p className="text-slate-200 text-sm font-medium mb-4">
                Selecione a resposta correta para prosseguir no treino:
              </p>
              
              <div className="grid grid-cols-1 gap-3 text-left">
                <button 
                  onClick={() => selecionarResposta("CORRECT")}
                  className={`p-3.5 rounded-xl text-xs font-bold transition-all border ${
                    statusAtual === "CORRECT" 
                      ? "bg-emerald-500/20 border-emerald-500 text-emerald-300 shadow-md shadow-emerald-500/10" 
                      : "bg-white/5 border-white/10 hover:bg-white/10 text-slate-200"
                  }`}
                >
                  A) Opção A (Exemplo Correto)
                </button>
                <button 
                  onClick={() => selecionarResposta("WRONG")}
                  className={`p-3.5 rounded-xl text-xs font-bold transition-all border ${
                    statusAtual === "WRONG" 
                      ? "bg-rose-500/20 border-rose-500 text-rose-300 shadow-md shadow-rose-500/10" 
                      : "bg-white/5 border-white/10 hover:bg-white/10 text-slate-200"
                  }`}
                >
                  B) Opção B (Exemplo Incorreto)
                </button>
              </div>
            </div>

          </div>
        )}
      </main>

      {/* 3. GAVETA INFERIOR FIXA (BARRA RETRÁTIL DO ZERO) */}
      {!capaAtiva && statusAtual !== "IDLE" && (
        <div 
          className={`fixed bottom-0 left-0 right-0 z-50 bg-[#070c18] border-t border-white/15 shadow-[0_-10px_30px_rgba(0,0,0,0.8)] transition-all duration-300 ease-in-out flex flex-col ${
            gavetaExpandida ? "h-72" : "h-16"
          }`}
        >
          {/* BARRA FIXA (ESTADO RETRAÍDO) */}
          <div 
            onClick={() => setGavetaExpandida(!gavetaExpandida)}
            className={`w-full h-16 px-5 flex items-center justify-between cursor-pointer border-b border-white/5 transition-colors shrink-0 ${
              statusAtual === "CORRECT" ? "bg-emerald-950/40 hover:bg-emerald-950/60" : "bg-rose-950/40 hover:bg-rose-950/60"
            }`}
          >
            <div className="flex items-center gap-3">
              {statusAtual === "CORRECT" ? (
                <div className="flex items-center gap-2 text-emerald-400 font-bold text-sm">
                  <CheckCircle2 size={22} className="shrink-0" />
                  <span>Acertou! Excelente resposta.</span>
                </div>
              ) : (
                <div className="flex items-center gap-2 text-rose-400 font-bold text-sm">
                  <XCircle size={22} className="shrink-0" />
                  <span>Não foi desta vez...</span>
                </div>
              )}
            </div>

            <div className="flex items-center gap-1.5 text-slate-400 text-xs font-mono font-semibold bg-white/5 px-3 py-1.5 rounded-lg border border-white/10">
              <span>{gavetaExpandida ? "Recolher" : "Ver Detalhes"}</span>
              {gavetaExpandida ? <ChevronDown size={18} className="text-amber-400" /> : <ChevronUp size={18} className="text-amber-400 animate-bounce" />}
            </div>
          </div>

          {/* CONTEÚDO EXPANDIDO */}
          <div className="p-5 flex-1 overflow-y-auto flex flex-col justify-between bg-[#030712]">
            <div className="space-y-2">
              <div className="flex items-center gap-2">
                <Sparkles size={14} className="text-amber-400" />
                <h4 className="text-xs font-mono font-bold text-amber-400 uppercase tracking-wider">
                  ANÁLISE E RESPOSTA CORRETA (SUPABASE)
                </h4>
              </div>
              <p className="text-xs text-slate-300 leading-relaxed bg-white/5 p-3 rounded-xl border border-white/5">
                {statusAtual === "CORRECT"
                  ? "Parabéns! Sua resposta está totalmente de acordo com as regras sintáticas registradas para esta lição."
                  : "A opção correta seria a Letra A. Veja a justificativa cadastrada na tabela para compreender o erro."}
              </p>
            </div>

            <button
              onClick={resetarResposta}
              className="w-full py-3 bg-gradient-to-r from-amber-500 to-orange-500 text-white font-black text-xs rounded-xl uppercase tracking-wider active:scale-95 transition-transform mt-3 cursor-pointer shadow-lg shadow-orange-500/20"
            >
              PRÓXIMO EXERCÍCIO ➔
            </button>
          </div>
        </div>
      )}

    </div>
  );
}
